# ---------------------------------------------------------------------------
# DocuFlow Backend - example environment file
#
#   cp .env.example .env
#
# Every value below is a safe placeholder. NEVER commit your real .env -
# it is already listed in .gitignore.
# ---------------------------------------------------------------------------

# --- Security / JWT --------------------------------------------------------
# Generate a real one with:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-hex-string
ALGORITHIM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL ------------------------------------------------------------
# Host-side port matches the mapping in docker-compose.yml
DB_USER=postgres
DB_PASSWORD=password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=docuflow_db

# --- MinIO (S3-compatible object storage) ----------------------------------
# Console UI: http://localhost:9101
MINIO_ENDPOINT=localhost:9100
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=docuflow-documents
MINIO_SECURE=False

# Host port overrides, so docker compose does not clash with services already
# running on your machine. Defaults match the values above.
# POSTGRES_HOST_PORT=5432
# REDIS_HOST_PORT=6380
# MINIO_API_PORT=9100
# MINIO_CONSOLE_PORT=9101

# --- Embeddings (RAG) ------------------------------------------------------
# If EMBEDDING_MODEL_PATH exists on disk the model is loaded locally and
# HuggingFace is never contacted; otherwise the hub id in EMBEDDING_MODEL_ID
# is downloaded. 384-dimensional vectors.
EMBEDDING_MODEL_PATH=models/all-MiniLM-L6-v2
EMBEDDING_MODEL_ID=all-MiniLM-L6-v2

# --- OpenRouter (RAG answer generation) ------------------------------------
# https://openrouter.ai/keys - leave blank to run without AI generation; the
# /query endpoints then return relevant excerpts instead of a composed answer.
# The default model is a free tier model and may be rate-limited upstream.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
# Optional second model for server-side failover; leave blank for one model.
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_TOKENS=900
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_RETRIES=4
OPENROUTER_REASONING_ENABLED=False
OPENROUTER_SITE_URL=http://localhost:5180
OPENROUTER_APP_NAME=DocuFlow

# --- Retrieval quality gate ------------------------------------------------
# Chunks scoring below RAG_MIN_SIMILARITY are discarded. If nothing clears the
# gate, the chat assistant answers from general knowledge and labels the answer.
RAG_MIN_SIMILARITY=0.34
RAG_MAX_CONTEXT_CHUNKS=5
RAG_HISTORY_TURNS=8

# --- Invitations -----------------------------------------------------------
# Public URL of the frontend, used to build /invite/{token} links.
FRONTEND_URL=http://localhost:5180
INVITATION_EXPIRE_DAYS=7

# ---------------------------------------------------------------------------
# DocuFlow — production environment
#
#   cp .env.production.example .env.production
#   # edit every value, then:
#   docker compose -f docker-compose.prod.yml --env-file .env.production up -d --build
#
# .env.production is git-ignored. Nothing here may be committed.
#
# The two hostnames below must already point at this server (see the DuckDNS
# section of the README). Caddy issues HTTPS certificates for them on first
# start, so they cannot be placeholders.
# ---------------------------------------------------------------------------

# --- Public hostnames (consumed by the Caddyfile and by the app) -----------
APP_DOMAIN=docuflow.duckdns.org
STORAGE_DOMAIN=minio-docuflow.duckdns.org

# --- Security / JWT --------------------------------------------------------
# Generate with:  openssl rand -hex 32
SECRET_KEY=change-me-to-a-long-random-hex-string
ALGORITHIM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- PostgreSQL ------------------------------------------------------------
# DB_HOST is the Compose service name, not localhost.
DB_USER=postgres
DB_PASSWORD=change-me-to-a-strong-password
DB_HOST=db
DB_PORT=5432
DB_NAME=docuflow

# --- Redis (Celery broker + result backend) --------------------------------
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
CELERY_TASK_DEFAULT_QUEUE=docuflow
# One child per worker: each loads its own copy of the embedding model.
CELERY_WORKER_CONCURRENCY=1
CELERY_TASK_SOFT_TIME_LIMIT=1500
CELERY_TASK_TIME_LIMIT=1800

# --- MinIO (object storage) ------------------------------------------------
# The app talks to MinIO over the private network (plain HTTP inside Docker),
# while the browser fetches presigned URLs over the public HTTPS origin. Both
# credentials must match MINIO_ROOT_USER / MINIO_ROOT_PASSWORD below.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-me-to-a-strong-secret
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-to-a-strong-secret
MINIO_BUCKET_NAME=docuflow-documents
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=False
MINIO_PUBLIC_ENDPOINT=https://minio-docuflow.duckdns.org
# Origin allowed to read presigned URLs from the browser.
MINIO_CORS_ALLOW_ORIGIN=https://docuflow.duckdns.org

# --- Embeddings (RAG) ------------------------------------------------------
# The image bakes the model at this path, so nothing is downloaded at runtime.
EMBEDDING_MODEL_PATH=models/all-MiniLM-L6-v2
EMBEDDING_MODEL_ID=all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_SEQ_LENGTH=256
CHUNK_MAX_TOKENS=200
CHUNK_OVERLAP_TOKENS=40
CHUNK_MIN_CHARS=120

# --- Gemini (primary answer provider) --------------------------------------
# Create a key in Google AI Studio. Leave blank to use OpenRouter only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=90
GEMINI_MAX_OUTPUT_TOKENS=1800
GEMINI_TEMPERATURE=0.1
GEMINI_MAX_RETRIES=2

# --- OpenRouter (fallback answer provider) ---------------------------------
OPENROUTER_API_KEY=
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,google/gemma-4-31b-it:free,xingchen-agi/xing4.0-29b-a4b:free,nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free
OPENROUTER_FALLBACK_MODEL=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT_SECONDS=90
OPENROUTER_MAX_TOKENS=1800
OPENROUTER_TEMPERATURE=0.1
OPENROUTER_MAX_RETRIES=4
OPENROUTER_REASONING_ENABLED=False
OPENROUTER_SITE_URL=https://docuflow.duckdns.org
OPENROUTER_APP_NAME=DocuFlow
LLM_PROVIDER_COOLDOWN_SECONDS=60

# --- Retrieval quality gate ------------------------------------------------
RAG_MIN_SIMILARITY=0.34
RAG_MAX_CONTEXT_CHUNKS=5
RAG_HISTORY_TURNS=8

# --- Invitations / CORS ----------------------------------------------------
FRONTEND_URL=https://docuflow.duckdns.org
INVITATION_EXPIRE_DAYS=7
# Extra browser origins allowed to call the API, comma-separated. Usually empty
# because the UI and API share one origin. Set it if the UI is hosted elsewhere.
BACKEND_CORS_ORIGINS=

# --- LangSmith tracing (optional) ------------------------------------------
# Turn on for traced ingestion and Ask-AI runs; leave off to stay fully offline.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=docuflow
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

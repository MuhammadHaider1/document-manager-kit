{
  "name": "docuflow-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Docuflow — document workflow and AI search for legal teams",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "api:types": "openapi-typescript openapi.json -o src/types/api.d.ts"
  },
  "dependencies": {

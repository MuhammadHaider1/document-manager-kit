# ---------------------------------------------------------------------------
# Docuflow web — environment variables
# Copy to `.env.local` for local development (`.env.local` is git-ignored).
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ---------------------------------------------------------------------------

# Base URL of the Docuflow API, including the version segment.
# Keep the default when the app is served from the same origin as the API
# (Vite dev proxy, the bundled nginx config, or your own reverse proxy).
# For a split deployment use the full URL, e.g. https://api.example.com/api/v1
# (the API must then allow this origin via CORS).
VITE_API_BASE_URL=/api/v1

# Product name shown in metadata and a few labels.
VITE_APP_NAME=Docuflow

# Largest file the UI will accept for upload, in megabytes.
# Keep this at or below the backend's own limit.
VITE_MAX_UPLOAD_MB=25

# Development only. The Vite dev server proxies /api/* to this origin so the
# browser makes same-origin requests and the API needs no CORS configuration.
# This value is never included in the production bundle.
VITE_DEV_API_PROXY=http://localhost:8000
